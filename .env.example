APP_NAME=Application Tracker Service
APP_ENV=development
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./application_tracker.db
# Optional for local development. Required when APP_ENV=production.
# API_KEY=replace-with-a-long-random-value
# Docker/PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://apptracker:change-me@db:5432/apptracker
